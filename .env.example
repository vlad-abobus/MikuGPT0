# Скопируй этот файл в .env и заполни ключи.
# .env не попадает в git.

# --- LLM: Google Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT=60
GEMINI_CONTEXT_WINDOW=1000000

# --- Озвучка: Fish Audio ---
# https://fish.audio/app/developers
FISH_API_KEY=your_fish_api_key_here
# ID голосовой модели Fish Audio из ссылки fish.audio/m/<id>
FISH_REFERENCE_ID=603c98f4bbca4e7aaca410231ed6b144
# Голоса для казахского, украинского и английского; можно задать отдельно.
FISH_REFERENCE_ID_KK=6717a74323274cb296ea9a0da654c977
FISH_REFERENCE_ID_UK=6717a74323274cb296ea9a0da654c977
FISH_REFERENCE_ID_EN=6717a74323274cb296ea9a0da654c977
# s2.1-pro-free — бесплатная модель для разработки; s2.1-pro — платная.
FISH_TTS_MODEL=s2.1-pro-free
FISH_API_URL=https://api.fish.audio/v1/tts
FISH_TIMEOUT=120
